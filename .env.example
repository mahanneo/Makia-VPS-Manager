# Runtime overrides. Never commit real secrets.
MAKIA_DATA_DIR=/opt/makia-vps-manager/data
MAKIA_DB_PATH=/opt/makia-vps-manager/data/makia.db
MAKIA_SECRET_PATH=/opt/makia-vps-manager/data/.secret
# Used only to bootstrap an empty database during installation.
# MAKIA_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password


# End-user Makia Client Platform (safe default: disabled)
# Set to 1 only after staging/UAT. Admin panel and existing protocol users are
# unaffected while this flag remains 0.
MAKIA_CLIENT_PORTAL_ENABLED=0
