[Unit]
Description=Makia VPS Manager
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/makia-vps-manager
Environment=MAKIA_DATA_DIR=/opt/makia-vps-manager/data
EnvironmentFile=-/etc/makia-vps-manager/makia.env
# Dedicated customer-bot secrets remain root-only and opt-in.
EnvironmentFile=-/etc/makia-vps-manager/telegram-shop.env
ExecStart=/opt/makia-vps-manager/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787 --proxy-headers
Restart=on-failure
RestartSec=3
UMask=0027
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
NoNewPrivileges=true
PrivateTmp=true
# The web service currently performs validated Linux account operations
# (useradd/usermod/chpasswd). ProtectSystem=full can prevent shadow-utils
# from acquiring /etc/.pwd.lock on some Ubuntu/systemd combinations.
# A dedicated privileged helper is planned for the stable architecture.
ProtectSystem=false
ReadWritePaths=/opt/makia-vps-manager/data /home /etc -/var/backups/makia-vps-manager

[Install]
WantedBy=multi-user.target
