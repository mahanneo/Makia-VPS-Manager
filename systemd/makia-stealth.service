[Unit]
Description=Makia Stealth TLS wrapper for OpenVPN
After=network-online.target openvpn-server@server.service
Wants=network-online.target
Requires=openvpn-server@server.service

[Service]
Type=simple
ExecStart=/usr/bin/stunnel4 /etc/stunnel/makia-openvpn.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=/etc/stunnel /etc/letsencrypt

[Install]
WantedBy=multi-user.target
