{
  "manifest_version": 3,
  "name": "Makia VPN",
  "version": "1.4.0",
  "description": "Secure Chrome/Edge companion for Makia Browser Only proxy and Windows Device VPN.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "proxy",
    "privacy"
  ],
  "action": {
    "default_title": "Makia VPN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/makia.png",
      "32": "icons/makia.png"
    }
  },
  "icons": {
    "16": "icons/makia.png",
    "32": "icons/makia.png",
    "48": "icons/makia.png",
    "128": "icons/makia.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
