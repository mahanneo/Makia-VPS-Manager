[Unit]
Description=Makia Telegram MTProto Proxy (mtg)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/makia-mtproxy/mtg
ConditionPathExists=/etc/makia-vps-manager/mtproxy.toml

[Service]
Type=simple
User=makia-mtproxy
Group=makia-mtproxy
WorkingDirectory=/opt/makia-mtproxy
ExecStart=/opt/makia-mtproxy/mtg run /etc/makia-vps-manager/mtproxy.toml
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Intentionally omitted: MemoryDenyWriteExecute can break some Go runtimes/architectures.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
