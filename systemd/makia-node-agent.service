[Unit]
Description=Makia Multi-VPS Node Heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/makia-node-agent
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/opt/makia-vps-manager
ReadWritePaths=/opt/makia-vps-manager/data
ProtectHome=read-only
