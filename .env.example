# Runtime overrides. Never commit real secrets.
MAKIA_DATA_DIR=/opt/makia-vps-manager/data
MAKIA_DB_PATH=/opt/makia-vps-manager/data/makia.db
MAKIA_SECRET_PATH=/opt/makia-vps-manager/data/.secret
# Used only to bootstrap an empty database during installation.
# MAKIA_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password


# End-user Makia Client Platform (safe default: disabled)
# Use auto to control the portal from the authenticated Admin UI after staging/UAT.
# Set 0 for an emergency hard-off or 1 for a hard-on override. Existing protocol
# users are unaffected by this switch.
MAKIA_CLIENT_PORTAL_ENABLED=auto

# Public HTTPS origin used by native Direct Connect when Makia is behind a reverse proxy.
# Example: https://panel.example.com
# MAKIA_PUBLIC_BASE_URL=https://panel.example.com

# HTTPS download URL for the approved Android Connector package shown inside Client PWA.
# Keep empty until the approved APK is published from a stable release location.
# MAKIA_ANDROID_CONNECTOR_URL=https://downloads.example.com/Makia-Android-Connector.apk

# MahiNet Commerce API source allowlist.
# Keep loopback-only when MahiNet and Makia share the same VPS. If the commerce
# backend moves to another trusted host, replace this with only that exact CIDR.
MAKIA_COMMERCE_ALLOWED_CIDRS=127.0.0.1/32,::1/128
