[Unit]
Description=Makia Operations Health and Alert Monitor
After=network-online.target makia-vps-manager.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/makia-vps-manager
Environment=MAKIA_DATA_DIR=/opt/makia-vps-manager/data
ExecStart=/opt/makia-vps-manager/.venv/bin/python -m app.ops_monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/makia-vps-manager/data /var/backups/makia-vps-manager
